{
  "name": "affiliate-content-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.14.0 <25.0.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise --config .dependency-cruiser.js apps packages",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "node scripts/run-with-env.mjs node scripts/infra-up.mjs",
    "infra:down": "node scripts/run-with-env.mjs docker compose down",
    "infra:logs": "node scripts/run-with-env.mjs docker compose logs -f",
    "infra:reset": "node scripts/run-with-env.mjs docker compose down -v",
    "verify:infrastructure-pins": "node scripts/verify-infrastructure-pins.mjs",
    "env:local": "node scripts/setup-local-env.mjs",
    "db:migrate": "node scripts/run-with-env.mjs tsx --conditions=development packages/infrastructure/src/database/migrations/cli.ts migrate",
    "db:migrate:status": "node scripts/run-with-env.mjs tsx --conditions=development packages/infrastructure/src/database/migrations/cli.ts status",
    "db:migrate:validate": "node scripts/run-with-env.mjs --set-node-env=test tsx --conditions=development packages/infrastructure/src/database/migrations/cli.ts validate",
    "test:integration": "node scripts/run-with-env.mjs --set-node-env=test vitest run -c vitest.integration.config.ts",
    "dev:web": "pnpm --filter @affiliate-content-os/web dev",
    "dev:api": "pnpm --filter @affiliate-content-os/api dev",
    "dev:worker": "pnpm --filter @affiliate-content-os/worker dev",
    "start:web": "pnpm --filter @affiliate-content-os/web start",
    "start:api": "pnpm --filter @affiliate-content-os/api start",
    "start:worker": "pnpm --filter @affiliate-content-os/worker start",
    "dev": "concurrently -n web,api,worker -c magenta,blue,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
