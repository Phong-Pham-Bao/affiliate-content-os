# Runtime environment mode (development, test, production)
NODE_ENV=development

# Logging level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# API server listener binding
API_HOST=127.0.0.1
API_PORT=3001

# Web application base URL (optional)
APP_BASE_URL=http://localhost:3000

# Server-only web upstream API base URL (optional in development/test, defaults to http://127.0.0.1:3001)
# WEB_API_BASE_URL=http://127.0.0.1:3001

# Local PostgreSQL container credentials and database name
POSTGRES_USER=acos_local
POSTGRES_PASSWORD=acos_local_only
POSTGRES_DB=acos_dev

# Runtime database connection URL (API and Worker)
DATABASE_URL=postgresql://acos_local:acos_local_only@127.0.0.1:5432/acos_dev

# Migration database connection URL (Schema migrations CLI)
MIGRATION_DATABASE_URL=postgresql://acos_local:acos_local_only@127.0.0.1:5432/acos_dev

# Test database admin connection URL (Integration testing harness only)
TEST_DATABASE_ADMIN_URL=postgresql://acos_local:acos_local_only@127.0.0.1:5432/postgres

# Safety opt-in for integration testing harness database drops
TEST_DATABASE_DISPOSABLE=YES_I_UNDERSTAND_TEST_DATABASES_WILL_BE_DROPPED

# Database SSL mode (disable, verify-full)
DATABASE_SSL_MODE=disable

# Authentication configuration (managed OIDC)
AUTH_ENABLED=false
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
# AUTH_TRANSACTION_ENCRYPTION_KEY=canonical-unpadded-base64url-32-random-bytes
# AUTH_TRANSACTION_KEY_VERSION=v1
# AUTH_TRANSACTION_TTL_SECONDS=600
# AUTH_SESSION_IDLE_TTL_SECONDS=1800
# AUTH_SESSION_ABSOLUTE_TTL_SECONDS=28800
# AUTH_SESSION_ROTATION_SECONDS=900
# AUTH_SESSION_ROTATION_GRACE_SECONDS=30
# AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300

# AI and Gemini API Configuration
AI_ENABLED=false
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=high
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_OUTPUT_TOKENS=8192
# WORKER_POLLING_INTERVAL_MS=2000
# WORKER_LEASE_DURATION_SECONDS=30
# AI_ESTIMATED_RESERVATION_MICROUNITS=50000
