{
  "openapi": "3.1.0",
  "info": {
    "title": "Affiliate Content OS - Application API",
    "version": "1.0.0",
    "description": "Managed OIDC authentication and opaque PostgreSQL-backed application sessions."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/auth/login": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Begin OIDC authorization-code flow",
        "description": "Generates state, nonce, PKCE S256 parameters, creates a one-time login transaction, sets the transaction cookie, and redirects to the identity provider authorization URL.",
        "parameters": [
          {
            "name": "returnTo",
            "in": "query",
            "required": false,
            "description": "Relative application redirect path to navigate after login.",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to identity provider authorization URL.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Identity provider authorization URL."
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "One-time transaction cookie acos_oidc_transaction."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            }
          },
          "400": {
            "description": "Invalid returnTo parameter.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Authentication disabled or provider discovery unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Complete OIDC authorization-code flow callback",
        "description": "Validates callback parameters against the one-time transaction cookie, exchanges authorization code, verifies ID token, resolves or provisions the principal, creates an opaque session, and redirects to the validated returnTo path.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Authorization code returned by provider."
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Opaque transaction state returned by provider."
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Provider error code if user or provider denied access."
          },
          {
            "name": "error_description",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "description": "Human-readable provider error description."
          },
          {
            "name": "error_uri",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "description": "URI identifying provider error page."
          },
          {
            "name": "acos_oidc_transaction",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "One-time browser-binding transaction secret."
          }
        ],
        "responses": {
          "303": {
            "description": "Redirects to validated application returnTo path with active session cookie.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Target application redirect URL."
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Sets acos_session and clears acos_oidc_transaction."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            }
          },
          "400": {
            "description": "Invalid or replayed callback parameters or state mismatch.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authenticated identity is disabled or unavailable.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Identity provider network or token exchange failure.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get authenticated user, session, and workspace access summary",
        "description": "Authenticates the opaque session cookie, sliding idle expiry and rotating token when due, and returns current user details and accessible active workspaces.",
        "parameters": [
          {
            "name": "acos_session",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque application session token."
          }
        ],
        "responses": {
          "200": {
            "description": "Current user, active session, and accessible workspaces.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Refreshed session cookie when rotation occurs."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "Current user, active session, and accessible workspaces.",
                  "type": "object",
                  "required": ["user", "session", "workspaceAccess"],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": ["id", "email", "displayName"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "email": {
                          "type": ["string", "null"]
                        },
                        "displayName": {
                          "type": ["string", "null"]
                        }
                      },
                      "additionalProperties": false
                    },
                    "session": {
                      "type": "object",
                      "required": ["idleExpiresAt", "absoluteExpiresAt"],
                      "properties": {
                        "idleExpiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "absoluteExpiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "additionalProperties": false
                    },
                    "workspaceAccess": {
                      "type": "object",
                      "required": ["items", "hasMore"],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["id", "name", "slug", "timezone", "role"],
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              },
                              "slug": {
                                "type": "string"
                              },
                              "timezone": {
                                "type": "string"
                              },
                              "role": {
                                "type": "string",
                                "enum": ["owner", "editor", "viewer"]
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Session cookie missing, invalid, expired, or revoked.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears acos_session cookie."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Authentication disabled.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke active application session",
        "description": "Validates request Origin, revokes the matching application session in PostgreSQL, scrubs hashes, and clears the session cookie.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Request origin validated against application base URL."
          },
          {
            "name": "acos_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Session cookie to revoke."
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked successfully.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears acos_session cookie."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            }
          },
          "400": {
            "description": "Unexpected request body or query parameters.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Request origin is invalid or untrusted.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Authentication disabled.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "post": {
        "tags": ["Workspaces"],
        "summary": "Create a new workspace",
        "description": "Creates a new workspace and owner membership for the authenticated user. Commits workspace, owner membership, idempotency record, and allowlisted audit event atomically.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[!-~]{1,128}$"
            },
            "description": "Mandatory idempotency key for safe duplicate prevention."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "description": "Request origin validated against application base URL."
          },
          {
            "name": "acos_session",
            "in": "cookie",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque application session token."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "slug", "timezone"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 64
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "brandVoice": {
                    "type": ["string", "null"],
                    "maxLength": 2000
                  },
                  "defaultDisclosure": {
                    "type": ["string", "null"],
                    "maxLength": 2000
                  },
                  "aiEnabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace created successfully with owner membership.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URI of the newly created workspace resource."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "slug",
                    "timezone",
                    "brandVoice",
                    "defaultDisclosure",
                    "aiEnabled",
                    "status",
                    "role",
                    "createdAt",
                    "updatedAt",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    },
                    "brandVoice": {
                      "type": ["string", "null"]
                    },
                    "defaultDisclosure": {
                      "type": ["string", "null"]
                    },
                    "aiEnabled": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["active", "suspended", "deletion_pending"]
                    },
                    "role": {
                      "type": "string",
                      "enum": ["owner", "editor", "viewer"]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "version": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or malformed idempotency key.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication session required.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Request origin is invalid or untrusted.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                },
                "description": "Disables caching for sensitive authentication responses."
              },
              "Pragma": {
                "schema": {
                  "type": "string",
                  "example": "no-cache"
                },
                "description": "Legacy HTTP 1.0 cache prevention."
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string",
                  "example": "no-referrer"
                },
                "description": "Prevents token leakage in Referer headers."
              }
            },
            "content": {
