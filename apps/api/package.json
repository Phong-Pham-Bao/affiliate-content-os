    "@affiliate-content-os/infrastructure": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.8.3"
  }
}
